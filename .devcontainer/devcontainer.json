{
    "name": "TensorFlow GPU Dev",
    "image": "nvcr.io/nvidia/tensorflow:24.03-tf2-py3",
    
    // Rimuovi --user per installare globalmente nel container (che è isolato)
    "postCreateCommand": "pip3 install -r requirements.txt",

    "runArgs": [
        "--gpus", "all",
        "--shm-size", "2gb" // Consigliato: evita crash con dataset pesanti
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.vscode-pylance"
            ]
        }
    },
    
    // Importante: le immagini NVIDIA usano root di default
    "remoteUser": "root"
}
